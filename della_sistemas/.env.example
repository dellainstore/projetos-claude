# ── Django ────────────────────────────────────────────────────────────────────
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=sua-secret-key-aqui

# Em produção: False
DEBUG=False

# Ex: sistemas.dellastore.com.br,localhost
ALLOWED_HOSTS=sistemas.dellastore.com.br

# ── Banco de dados dos Produtos ───────────────────────────────────────────────
# Caminho absoluto para o inclusoes.db (banco do módulo produtos)
PRODUTOS_DB_PATH=/var/www/della-sistemas/projetos-claude/della_sistemas/data/produtos/inclusoes.db

# ── Bling OAuth ───────────────────────────────────────────────────────────────
BLING_AUTH_DIR=/var/www/della-sistemas/shared/bling_auth
BLING_CLIENT_ID=seu-client-id-bling
BLING_CLIENT_SECRET=seu-client-secret-bling
BLING_DEPOSITO_ID=seu-deposito-id

# Meta Marketing API (painel de Anuncios)
META_ADS_ACCOUNT_ID=
META_ADS_TOKEN=

# Segredo compartilhado com o site_della para criar link curto (deve ser
# IDENTICO ao LINK_CURTO_SECRET do site_della)
LINK_CURTO_SECRET=
SITE_URL=https://www.dellainstore.com

# Motoqueiro (Lalamove) — pegar em developers.lalamove.com > API Keys
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_MARKET=BR
LALAMOVE_SANDBOX=True
# Webhook (developers.lalamove.com > Webhooks): se a Lalamove exigir um
# segredo separado para validar o payload do webhook, colar aqui. Se nao
# existir campo separado no painel deles, deixar vazio (usa o API_SECRET).
LALAMOVE_WEBHOOK_SECRET=

# Motoqueiro (Loggi) — ESQUELETO, ainda nao habilitado na tela de Solicitar.
# Conseguir com o time comercial/Sales Engineering da Loggi (nao tem
# autoatendimento tipo a Lalamove) — ver memory/project_loggi_integracao_motoqueiro.md
LOGGI_CLIENT_ID=
LOGGI_CLIENT_SECRET=
LOGGI_COMPANY_ID=
LOGGI_EXTERNAL_SERVICE_ID=
LOGGI_SANDBOX=True
# Webhook: usuario/senha combinados com o time de vendas da Loggi ao
# cadastrar o endpoint (https://sistemas.dellainstore.com/motoqueiro/webhook/loggi/)
LOGGI_WEBHOOK_USER=
LOGGI_WEBHOOK_PASSWORD=

# Autocomplete de endereco (Motoqueiro) com numero de porta exato — Google
# Cloud Console > Places API + Geocoding API habilitadas, chave restrita por
# IP do servidor. Sem essa chave, o autocomplete cai pro Nominatim (gratis,
# mas sem numero em varias ruas do Brasil).
GOOGLE_PLACES_API_KEY=

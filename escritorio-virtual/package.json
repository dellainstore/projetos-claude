{
  "name": "escritorio-virtual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend do escritorio virtual da D'ELLA. Workspace de BUILD apenas: nao roda processo Node em producao.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('dist-test/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test dist-test/tests/",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  }
}
